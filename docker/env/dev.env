# ── dev 模式 ────────────────────────────────────────────────────────────────
# bind mount + HMR + xdebug + phpMyAdmin。原始碼改了立刻生效，不用 rebuild。
APP_MODE=dev
APP_ENV=local
APP_DEBUG=true
APP_TARGET=dev
NUXT_TARGET=dev
FRONTEND_MODE=ssr

# dev 走 runtime environment，不是 build arg —— build arg 進不了 nuxt dev。
NUXT_SSR=true

# ── host 埠段 ───────────────────────────────────────────────────────────────
# -p pm_dev 只隔離容器／網路／volume，**不隔離 host 埠**。
# 三個模式要能同時 up，就必須各自佔用不同埠段。
EDGE_HTTP_PORT=8080
NUXT_PORT=3000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8891

# MySQL 只綁 loopback，不要曝在區網上。
MYSQL_BIND=127.0.0.1

APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:3000,127.0.0.1:3000
SESSION_SECURE_COOKIE=false

# xdebug：dev 才開。start_with_request=trigger 而非 yes ——
# yes 會讓每個請求都去連 IDE，沒開 IDE 時每次都要等 connect_timeout。
XDEBUG_MODE=debug
XDEBUG_START=trigger
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

LOG_LEVEL=debug
DB_FRESH=false

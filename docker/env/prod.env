# ── prod 模式 ───────────────────────────────────────────────────────────────
# 錯誤關閉、opcache preload、無管理工具、無掃描器、無 xdebug（build 時斷言）。
APP_MODE=prod
APP_ENV=production
APP_DEBUG=false
APP_TARGET=prod
NUXT_TARGET=prod
FRONTEND_MODE=ssr
NUXT_SSR=true

# ── host 埠段 ───────────────────────────────────────────────────────────────
# 只發布 80。
# 刻意**不發布 8443**：compose 裡的 edge 沒有 listen ssl 區塊，
# 發布了卻沒有 TLS 會讓 SESSION_SECURE_COOKIE=true 的 Filament 登入陷入無限 419。
# 正式環境的 TLS 由 Ansible 那條路的 certbot + MyGuard nginx 處理（claude.md §6）。
EDGE_HTTP_PORT=80

# MySQL 與 phpMyAdmin 完全不發布（overlay 裡沒有對應的 ports:）。
# 這兩個變數只是為了讓 compose 插值不缺鍵，實際沒有 ports 引用它們。
MYSQL_PORT=0
PHPMYADMIN_PORT=0
MYSQL_BIND=127.0.0.1
NUXT_PORT=0

APP_URL=http://localhost
FRONTEND_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# 沒有 TLS 就不能設 true —— 見上面 8443 的說明。
SESSION_SECURE_COOKIE=false

XDEBUG_MODE=off
XDEBUG_START=trigger
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
# 0=不寫 log。連不上 IDE 時調高（1~7）才有線索，查完記得調回來。
XDEBUG_LOG_LEVEL=0

LOG_LEVEL=error
DB_FRESH=false

# {{ ansible_managed }}
# ============================================================================
# {{ backend_shared_env_path }}
#
# 這份檔案由 **template** 產生，不是 lineinfile 也不是 sed。
# 理由：密碼可能含 & | * ? $ / 空白等字元。
#   sed 的替換字串會把 & 當成「整段比對到的內容」、把 / 當成分隔符；
#   lineinfile 的 regexp 也會被元字元污染。
# 兩者都會靜靜寫出一個錯的密碼，然後你會在 nginx 500 頁面上花一個下午。
#
# 權限：0640 {{ deploy_user }}:{{ web_group }}
#   deploy 要能寫（key:generate 透過 <release>/.env 這個 symlink 寫回這裡）
#   php-fpm 以 {{ web_user }} 執行，只需要讀
#   others 完全沒有權限
# ============================================================================
{#
   dotenv 值的輸出規則：
     * 反斜線與雙引號一律跳脫（phpdotenv 對雙引號字串會處理這兩個轉義）；
     * ${...} 會被 phpdotenv 當成巢狀變數展開 —— assert.yml 已經擋掉含 ${ 的值；
     * APP_KEY 刻意「不加引號」，理由見下面。
#}
{% macro q(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro %}
{% macro yn(value) -%}
{{ 'true' if (value | bool) else 'false' }}
{%- endmacro %}

APP_NAME={{ q(app_name) }}
APP_ENV={{ q(app_env) }}
{#
  APP_KEY 不加引號是刻意的。
  Laravel 的 KeyGenerateCommand 用 /^APP_KEY=<目前的值>/m 做替換：
  寫成 APP_KEY="" 時，「目前的值」被解析成空字串，替換後會留下尾巴 →
      APP_KEY=base64:xxxx""
  也就是一把永遠錯的金鑰。不加引號才會被乾淨取代。
  base64 的字元集是 A-Za-z0-9+/= ，在 dotenv 裡不需要引號。
#}
APP_KEY={{ backend_app_key_effective | default('') }}
APP_DEBUG={{ yn(backend_app_debug) }}
APP_URL={{ q(backend_app_url) }}
FRONTEND_URL={{ q(backend_frontend_url) }}

APP_LOCALE={{ q(backend_locale) }}
APP_FALLBACK_LOCALE={{ q(backend_fallback_locale) }}
APP_FAKER_LOCALE={{ q(backend_faker_locale) }}
{#
  注意：這個值目前是「無效」的。
  src/backend/config/app.php:68 寫死了 'timezone' => 'UTC'，並沒有讀 env('APP_TIMEZONE')。
  （.env.example 裡有 APP_TIMEZONE=Asia/Taipei，但 config 沒接上去。）
  仍然輸出它是為了跟 .env.example 一致，將來 config 改成
      'timezone' => env('APP_TIMEZONE', 'UTC'),
  之後不用再動這份模板。
  在那之前，PHP 端的時區由 php role 的 php_timezone（date.timezone）決定，
  Laravel 的 Carbon/資料庫時間戳則一律是 UTC。
#}
APP_TIMEZONE={{ q(app_timezone) }}

LOG_CHANNEL={{ q(backend_log_channel) }}
LOG_STACK={{ q(backend_log_stack) }}
LOG_LEVEL={{ q(backend_log_level) }}
LOG_DAILY_DAYS={{ backend_log_daily_days | int }}

# A3：mysql role 開了 skip-name-resolve，MySQL 不做反解，
# 授權比對的是字面 host。所以 mysql_app_user_hosts 同時建了
# 'localhost'（unix socket）與 '127.0.0.1'（TCP）兩筆。
# 這裡用 127.0.0.1 走 TCP；改成 localhost 會走 socket，兩條路都通。
DB_CONNECTION={{ q(backend_db_connection) }}
DB_HOST={{ q(backend_db_host) }}
DB_PORT={{ backend_db_port | int }}
DB_DATABASE={{ q(backend_db_database) }}
DB_USERNAME={{ q(backend_db_username) }}
DB_PASSWORD={{ q(backend_db_password) }}

SESSION_DRIVER={{ q(backend_session_driver) }}
SESSION_LIFETIME={{ backend_session_lifetime | int }}
SESSION_ENCRYPT=false
SESSION_PATH=/
{#
  同源部署（nginx 把 / 給 Nuxt、/api|/admin|/up|/storage 給 PHP），
  cookie 用 host-only 就夠，不需要跨子網域，所以 SESSION_DOMAIN 留 null。
  要跨子網域（api.example.com + app.example.com）才改成 .example.com，
  屆時 SANCTUM_STATEFUL_DOMAINS 也要一起改。
#}
SESSION_DOMAIN={{ backend_session_domain }}
SESSION_SECURE_COOKIE={{ yn(backend_session_secure_cookie) }}
SESSION_SAME_SITE={{ q(backend_session_same_site) }}

# Sanctum 的 SPA 認證：這個清單裡的網域才會走 cookie session 而不是 token。
# config/cors.php 的 allowed_origins 是 [env('FRONTEND_URL')]，
# supports_credentials 是 true，所以 FRONTEND_URL 與這裡必須指向同一個來源。
SANCTUM_STATEFUL_DOMAINS={{ q(backend_sanctum_stateful_domains) }}

BROADCAST_CONNECTION={{ q(backend_broadcast_connection) }}
FILESYSTEM_DISK={{ q(backend_filesystem_disk) }}
QUEUE_CONNECTION={{ q(backend_queue_connection) }}
CACHE_STORE={{ q(backend_cache_store) }}
{% if backend_redis_enabled | bool %}

# Redis：沒有任何 role 會安裝它，打開 backend_redis_enabled 之前
# 請先自行確認 redis-server 與 php{{ php_version }}-redis 都在。
REDIS_CLIENT=phpredis
REDIS_HOST={{ q(backend_redis_host) }}
REDIS_PORT={{ backend_redis_port | int }}
REDIS_PASSWORD={{ q(backend_redis_password) }}
{% endif %}

MAIL_MAILER={{ q(backend_mail_mailer) }}
MAIL_FROM_ADDRESS={{ q(backend_mail_from_address) }}
MAIL_FROM_NAME={{ q(backend_mail_from_name) }}

VITE_APP_NAME={{ q(app_name) }}
{% if backend_env_extra %}

# ---- backend_env_extra ----
{% for key, value in (backend_env_extra | dictsort) %}
{{ key }}={{ q(value) }}
{% endfor %}
{% endif %}

# ── test 模式 ───────────────────────────────────────────────────────────────
# 不可變映像（原始碼烘進 image，不 bind mount）+ ModSecurity WAF + 掃描工具。
# 這個模式的存在意義是「被掃」：ZAP 打 waf:8080，WAF 再轉給 edge。
APP_MODE=test
APP_ENV=testing
APP_DEBUG=false
APP_TARGET=test
NUXT_TARGET=prod
FRONTEND_MODE=ssr
NUXT_SSR=true

# ── host 埠段（與 dev 完全不重疊）─────────────────────────────────────────────
EDGE_HTTP_PORT=18080
WAF_HTTP_PORT=18081
NUXT_PORT=13000
MYSQL_PORT=13306
PHPMYADMIN_PORT=18891
MYSQL_BIND=127.0.0.1

# 對外入口是 WAF，所以 APP_URL 指向 WAF 的埠。
APP_URL=http://localhost:18081
FRONTEND_URL=http://localhost:18081
SANCTUM_STATEFUL_DOMAINS=localhost:18081,127.0.0.1:18081
SESSION_SECURE_COOKIE=false

# test 映像「裝了 xdebug 但預設關閉」—— 只在要收覆蓋率時才由 cx test 打開。
# 常開會讓 ZAP 的時間量測全部失真。
XDEBUG_MODE=off
XDEBUG_START=trigger
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
# 0=不寫 log。連不上 IDE 時調高（1~7）才有線索，查完記得調回來。
XDEBUG_LOG_LEVEL=0

# ── WAF ─────────────────────────────────────────────────────────────────────
# DetectionOnly = 只記錄不攔。cx scan dast 會分別以 DetectionOnly 與 On
# 各跑一次 ZAP，兩者的差集就是 WAF 的實際攔截率。
MODSEC_RULE_ENGINE=DetectionOnly
MODSEC_PARANOIA=1
MODSEC_ANOMALY_INBOUND=5
MODSEC_ANOMALY_OUTBOUND=4

LOG_LEVEL=warning

# ⚠ 一次性化：entrypoint 用哨兵檔記住「這個 volume 已經 fresh 過了」。
# base 是 restart: unless-stopped，entrypoint 每次啟動都會跑 ——
# 一次 OOM kill 就會在 ZAP 掃描中途 migrate:fresh --seed，掃描結果全部失真。
DB_FRESH=true

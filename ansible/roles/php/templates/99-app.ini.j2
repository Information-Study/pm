; {{ ansible_managed }}
; ============================================================================
; {{ app_slug }} — PHP {{ php_version }} 正式環境設定
;
; 這個檔只會被放進 {{ php_fpm_conf_d }}，**絕不放進 {{ php_cli_conf_d }}**。
;
; 理由（A2）：backend/composer.json 的 post-autoload-dump 會執行
;     @php artisan package:discover --ansi
;     @php artisan filament:upgrade
; 這兩個腳本經由 Symfony Process 呼叫 proc_open。CLI 一旦套上 disable_functions，
; composer install 會直接死於：
;     The Process class relies on proc_open, which is not available on your
;     PHP installation.
; 所以 CLI 保持乾淨（distro 的 cli/php.ini 預設就是 memory_limit=-1、
; max_execution_time=0、disable_functions 空值，對 artisan 與 composer 剛好）。
; ============================================================================

[PHP]
expose_php = {{ php_expose_php }}
display_errors = {{ php_display_errors }}
display_startup_errors = {{ php_display_startup_errors }}
log_errors = On
error_reporting = {{ php_error_reporting }}
; 錯誤實際寫到哪裡由 pool 的 php_admin_value[error_log] 決定。

memory_limit = {{ php_memory_limit }}
max_execution_time = {{ php_max_execution_time }}
max_input_time = {{ php_max_input_time }}
; Filament 的表格 / 巢狀表單一次會送很多欄位，預設 1000 容易被吃掉。
max_input_vars = {{ php_max_input_vars }}

; ---- A16：上傳限制。四個值的單一來源是 app_max_upload_mb = {{ app_max_upload_mb }} ----
;   php  upload_max_filesize = {{ php_upload_max_filesize }}
;   php  post_max_size       = {{ php_post_max_size }}   （>= upload_max_filesize）
;   nginx client_max_body_size / waf request body limit 必須依序更大，
;   否則 {{ app_max_upload_mb }}MB 附近的上傳會過了 nginx 與 PHP 才被 WAF 擋成 413。
upload_max_filesize = {{ php_upload_max_filesize }}
post_max_size = {{ php_post_max_size }}
file_uploads = On
max_file_uploads = 20

date.timezone = {{ php_timezone }}

; Laravel 用 try_files $uri /index.php?$query_string 走前端控制器，不吃 PATH_INFO。
cgi.fix_pathinfo = {{ php_cgi_fix_pathinfo }}

realpath_cache_size = {{ php_realpath_cache_size }}
realpath_cache_ttl = {{ php_realpath_cache_ttl }}

; production 不做執行期 assert
zend.assertions = -1
zend.exception_ignore_args = On

; ---- session（Laravel 走自己的 session driver，這裡只是不要留下更差的預設）----
session.cookie_httponly = 1
session.cookie_secure = {{ php_session_cookie_secure }}
session.cookie_samesite = {{ php_session_cookie_samesite }}
session.use_strict_mode = 1

; ---- disable_functions（僅 FPM）--------------------------------------------
; 刻意不含 proc_open / proc_get_status / proc_close —— 見檔頭說明。
disable_functions = {{ php_disable_functions | join(',') }}
{% if php_extra_ini | length > 0 %}

; ---- php_extra_ini ---------------------------------------------------------
{% for key, value in (php_extra_ini | dictsort) %}
{{ key }} = {{ value }}
{% endfor %}
{% endif %}

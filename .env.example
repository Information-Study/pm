# ── pm 根目錄 .env 範本 ──────────────────────────────────────────────────────
# cx setup 會把這個檔複製成 .env（不會覆蓋既有的），並產生隨機密碼。
#
# 這個檔放「三個模式共用」的值：映像 tag、資料庫憑證、UID/GID。
# 模式專屬的值（埠、build target、APP_DEBUG）放 docker/env/<mode>.env。
# cx 的 --env-file 順序是 .env 先、docker/env/<mode>.env 後，所以後者可以覆蓋前者。
#
# ⚠ .env 已被 .gitignore 排除。本 repo 是 PUBLIC，不要把真實密碼寫進 .env.example。

# ── 映像 ────────────────────────────────────────────────────────────────────
# 版本鎖定理由見 claude.md §1 的 LTS 政策表。不要為了「找 LTS」而降版。
IMAGE_PREFIX=pm
PHP_IMAGE=php:8.5-fpm-alpine
NODE_IMAGE=node:24.20-alpine
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.30-alpine
PHPMYADMIN_IMAGE=phpmyadmin:5
WAF_IMAGE=owasp/modsecurity-crs:nginx-alpine
# ⚠ SonarQube Community 版**沒有 LTA 線**。
#
# 這個專案原本寫 sonarqube:2026-lta-community —— 那個 tag 在 Docker Hub 上
# 根本不存在，cx sonar up 會直接
#   failed to resolve reference "docker.io/library/sonarqube:2026-lta-community": not found
#
# 2026-09-04 查證 Docker Hub 的實際 tag：
#   2026.1.x / 2026.4.x 這種 LTA 版號  →  只有 -enterprise / -developer /
#                                          -datacenter，**沒有 -community**
#   lts-community                      →  停在 SonarQube 9.9（2025-09-02 之後
#                                          就沒再更新），那是 2023 年的線，已是死路
#   community / latest                 →  滾動發布，目前 26.9.0
#
# 也就是說自從 Community 版改名為「SonarQube Community Build」之後，
# LTA 就變成商業版才有的概念。claude.md §1 的 LTS 表對 SonarQube 的敘述是錯的。
#
# 因此這裡改成「釘一個明確的 community 版號」：可重現、可審查，
# 升級是刻意的動作而不是某天 latest 自己換掉。
# 升版方式：到 hub.docker.com/_/sonarqube/tags 找最新的 *-community 版號。
SONARQUBE_IMAGE=sonarqube:26.9.0.129388-community
POSTGRES_IMAGE=postgres:17-alpine

# ── 容器內的檔案擁有者 ───────────────────────────────────────────────────────
# 必須對上 host 端的你，否則 bind mount 進來的 backend/ 你自己寫不進去。
# cx setup 會自動填入 id -u / id -g。
APP_UID=1000
APP_GID=1000

# ── 資料庫 ──────────────────────────────────────────────────────────────────
# cx setup 會用 A-Za-z0-9 產生（刻意不含 / + & —— 見 claude.md §3 陷阱 5：
# 用 sed 套密碼會被 & 與 / 靜默竄改，一小時後才以 Access denied 現形）。
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
DB_DATABASE=pm
DB_USERNAME=pm
DB_PASSWORD=__CHANGE_ME__

# ── 應用 ────────────────────────────────────────────────────────────────────
# 空字串 = 同源（前端經 edge 打 /api，不跨源）。三個模式都以 edge 為單一入口，
# 所以這裡刻意留空 —— 見 claude.md §4「前端三模式」。
NUXT_PUBLIC_API_BASE_URL=
APP_TIMEZONE=Asia/Taipei
APP_LOCALE=zh_TW

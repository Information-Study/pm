# ── pm 根目錄 .env 範本 ──────────────────────────────────────────────────────
# cx setup 會把這個檔複製成 .env（不會覆蓋既有的），並產生隨機密碼。
#
# 這個檔放「三個模式共用」的值：映像 tag、資料庫憑證、UID/GID。
# 模式專屬的值（埠、build target、APP_DEBUG）放 env/docker/compose/<mode>.env。
# cx 的 --env-file 順序是 .env 先、env/docker/compose/<mode>.env 後，所以後者可以覆蓋前者。
#
# ⚠ .env 已被 .gitignore 排除。本 repo 是 PUBLIC，不要把真實密碼寫進 .env.example。

# ── 專案識別 ────────────────────────────────────────────────────────────────
# compose 網路名（<slug>_<mode>_net）與映像前綴的來源。
# cx setup env 會從 .cxroot 的 CX_PROJECT_NAME 填入，所以拿這個 repo 當範本
# 改名之後不必手動改這裡 —— 改 .cxroot 就好。
PROJECT_SLUG=pm

# ── 映像 ────────────────────────────────────────────────────────────────────
# 版本鎖定理由見 claude.md §1 的 LTS 政策表。不要為了「找 LTS」而降版。
IMAGE_PREFIX=pm
PHP_IMAGE=php:8.5-fpm-alpine
NODE_IMAGE=node:24.20-alpine
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.30-alpine
PHPMYADMIN_IMAGE=phpmyadmin:5.2.3
WAF_IMAGE=owasp/modsecurity-crs:4.28.0-nginx-alpine-202608131208
# ⚠ SonarQube Community 版**沒有 LTA 線**。
#
# 這個專案原本寫 sonarqube:2026-lta-community —— 那個 tag 在 Docker Hub 上
# 根本不存在，cx sonar up 會直接
#   failed to resolve reference "docker.io/library/sonarqube:2026-lta-community": not found
#
# 2026-09-04 查證 Docker Hub 的實際 tag：
#   2026.1.x / 2026.4.x 這種 LTA 版號  →  只有 -enterprise / -developer /
#                                          -datacenter，**沒有 -community**
#   lts-community                      →  停在 SonarQube 9.9（2025-09-02 之後
#                                          就沒再更新），那是 2023 年的線，已是死路
#   community / latest                 →  滾動發布，目前 26.9.0
#
# 也就是說自從 Community 版改名為「SonarQube Community Build」之後，
# LTA 就變成商業版才有的概念。claude.md §1 的 LTS 表對 SonarQube 的敘述是錯的。
#
# 因此這裡改成「釘一個明確的 community 版號」：可重現、可審查，
# 升級是刻意的動作而不是某天 latest 自己換掉。
# 升版方式：到 hub.docker.com/_/sonarqube/tags 找最新的 *-community 版號。
SONARQUBE_IMAGE=sonarqube:26.9.0.129388-community
POSTGRES_IMAGE=postgres:17.11-alpine

# SonarQube 是獨立的 compose project（cx sonar up 用 -p <專案>_devsecops），
# dev 與 test 共用。這兩個旋鈕以前完全沒有出現在任何 .env.example 或
# env/docker/compose/*.env 裡，但 env/docker/compose/sonar.yml 與 bin/cmd/sonar.sh 都在讀 ——
# 於是 PostgreSQL 的密碼一路靜默用 compose 裡的字面預設值 `sonar`，
# 而且沒有任何文件告訴你有這個旋鈕可以改。
SONAR_PORT=9000
SONAR_DB_PASSWORD=__CHANGE_ME__

# ── 容器內的檔案擁有者 ───────────────────────────────────────────────────────
# 必須對上 host 端的你，否則 bind mount 進來的 backend/ 你自己寫不進去。
# cx setup 會自動填入 id -u / id -g。
APP_UID=1000
APP_GID=1000

# ── 資料庫 ──────────────────────────────────────────────────────────────────
# cx setup 會用 A-Za-z0-9 產生（刻意不含 / + & —— 見 claude.md §3 陷阱 5：
# 用 sed 套密碼會被 & 與 / 靜默竄改，一小時後才以 Access denied 現形）。
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
DB_DATABASE=pm
DB_USERNAME=pm
DB_PASSWORD=__CHANGE_ME__

# ── Xdebug（dev 與 test 映像裝了；prod 有 build 斷言擋住）──────────────────
# 五個旋鈕都由 env/docker/entrypoint/app.sh 在啟動時寫成 zz-xdebug.ini。
# XDEBUG_MODE=off 時完全不寫設定檔，所以關掉是真的關掉，沒有效能代價。
#
# 舊專案（example/php/xdebug.ini）是 mode=debug + start_with_request=yes ——
# 每一個請求都嘗試連 IDE。這裡預設 trigger：只有帶 XDEBUG_TRIGGER
# （cookie / GET / POST 參數，VS Code 的 PHP Debug 外掛會自動帶）才啟動，
# 沒開 IDE 的時候不會每個請求都等連線逾時。
# 要完全復刻舊行為就把 START 改成 yes。
XDEBUG_MODE=off
XDEBUG_START=trigger
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
# 0 = 不輸出。調到 7 會把每一次連線嘗試寫進容器 log，
# 是「IDE 連不上、但看不出為什麼」時唯一有用的線索。
# 這一行以前漏了 —— compose 與 entrypoint 都在用它，只有 .env.example 沒寫，
# 而上面那段註解還宣稱「所有旋鈕都在這」。
XDEBUG_LOG_LEVEL=0

# ── 應用 ────────────────────────────────────────────────────────────────────
# Laravel 的加密金鑰。**必填**，由 cx setup env 自動產生。
#
# 為什麼要在這裡而不是讓容器自己產：backend/.env 現在被 .dockerignore 排除
# （否則它會連同 APP_KEY 一起被烘進映像層），而容器裡的 .env 落在 writable
# layer、不在任何 volume 上 —— 也就是說每一次 --force-recreate 都會換一把新
# 金鑰，把所有 session 與 encrypted cast 的資料變成解不開的亂碼。
# 從 compose 注入才能讓它跨容器重建保持不變（config/app.php 是 env('APP_KEY')）。
APP_KEY=__CHANGE_ME__

# 空字串 = 同源（前端經 edge 打 /api，不跨源）。三個模式都以 edge 為單一入口，
# 所以這裡刻意留空 —— 見 claude.md §4「前端三模式」。
NUXT_PUBLIC_API_BASE_URL=
APP_TIMEZONE=Asia/Taipei
APP_LOCALE=zh_TW

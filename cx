#!/usr/bin/env bash
# cx — pm 專案統一入口。
# 用法：cx [全域旗標] <動詞> [參數...]
# 可從專案任何子目錄執行（向上搜尋 .cxroot）。

set -Eeuo pipefail

CX_INVOKE_PWD=$PWD          # 必須在任何 cd 之前記下

# ---- 全域旗標：要在載入函式庫「之前」解析，因為 --root 會決定去哪裡載 ----
CX_ROOT_OVERRIDE=''
CX_MODE_OVERRIDE=''
CX_DRY_RUN=0
CX_ASSUME_YES=0
CX_UI=auto

while (( $# )); do
    case $1 in
        --root)     [[ -n ${2:-} ]] || { printf 'cx: --root 需要路徑\n' >&2; exit 2; }
                    CX_ROOT_OVERRIDE=$2; shift 2 ;;
        --root=*)   CX_ROOT_OVERRIDE=${1#*=}; shift ;;
        --mode)     [[ -n ${2:-} ]] || { printf 'cx: --mode 需要 dev|test|prod\n' >&2; exit 2; }
                    CX_MODE_OVERRIDE=$2; shift 2 ;;
        --mode=*)   CX_MODE_OVERRIDE=${1#*=}; shift ;;
        --ui)       [[ -n ${2:-} ]] || { printf 'cx: --ui 需要 whiptail|dialog|plain\n' >&2; exit 2; }
                    CX_UI=$2; shift 2 ;;
        --ui=*)     CX_UI=${1#*=}; shift ;;
        --dry-run)  CX_DRY_RUN=1; shift ;;
        --yes|-y)   CX_ASSUME_YES=1; shift ;;
        -h|--help)  set -- help; break ;;
        --)         shift; break ;;
        -*)         printf 'cx: 未知的全域旗標 %s\n' "$1" >&2; exit 2 ;;
        *)          break ;;
    esac
done
# 必須驗證：未驗證的 --ui 會讓 _cx_dlg 的 case 找不到分支而「什麼都不做並回傳 0」，
# 而 cx_interactive() 只排除 plain，於是 bogus 被當成互動模式 →
# 每個 cx_confirm 直接回 0 = 已確認 → cx fresh 的刪除閘門、git push、
# guard remove、branch delete、uninstall 全部形同虛設。
case $CX_UI in
    auto|whiptail|dialog|plain) : ;;
    *) printf 'cx: --ui 只接受 whiptail|dialog|plain（收到 %s）\n' "$CX_UI" >&2; exit 2 ;;
esac
# CX_MODE 會被拿去組 -p pm_${CX_MODE} 與 -f docker/compose/${CX_MODE}.yml，
# 不驗證等於留一個檔名／專案名注入面給 Phase 2。
case $CX_MODE_OVERRIDE in
    ''|dev|test|prod) : ;;
    *) printf 'cx: --mode 只接受 dev|test|prod（收到 %s）\n' "$CX_MODE_OVERRIDE" >&2; exit 2 ;;
esac
export CX_DRY_RUN CX_ASSUME_YES CX_UI CX_INVOKE_PWD

# ---- 定位根目錄 ----
if [[ -n $CX_ROOT_OVERRIDE ]]; then
    CX_ROOT=$(cd "$CX_ROOT_OVERRIDE" && pwd -P) || { echo "cx: --root 路徑無效" >&2; exit 2; }
    [[ -f $CX_ROOT/.cxroot ]] || { echo "cx: $CX_ROOT 沒有 .cxroot" >&2; exit 3; }
else
    # 解析自身位置（可能是 symlink）
    _self=${BASH_SOURCE[0]}
    while [[ -L $_self ]]; do
        _d=$(cd -P "$(dirname "$_self")" && pwd)
        _self=$(readlink "$_self")
        [[ $_self != /* ]] && _self=$_d/$_self
    done
    _selfdir=$(cd -P "$(dirname "$_self")" && pwd)

    CX_ROOT=''
    # 先從呼叫者的 cwd 往上找，找不到再退回 cx 自身所在目錄
    for _start in "$CX_INVOKE_PWD" "$_selfdir"; do
        _d=$(cd "$_start" 2>/dev/null && pwd -P) || continue
        while [[ $_d != / ]]; do
            [[ -f $_d/.cxroot ]] && { CX_ROOT=$_d; break 2; }
            _d=$(dirname "$_d")
        done
    done
    [[ -n $CX_ROOT ]] || { echo "cx: 找不到 .cxroot（不在 pm 專案內？）" >&2; exit 3; }
fi
export CX_ROOT

# ---- 載入函式庫（明確順序，不用 glob）----
for _lib in common ui; do
    # shellcheck source=/dev/null
    . "$CX_ROOT/bin/lib/$_lib.sh"
done
trap cx_on_err ERR

# shellcheck source=/dev/null
. "$CX_ROOT/.cxroot"

cx_ui_init

CX_MODE=${CX_MODE_OVERRIDE:-${CX_MODE:-dev}}
export CX_MODE

# ---- 動詞分派 ----
# 有些動詞的實作與檔名不同名，用對照表處理
declare -A CX_CMD_FILE_OF=(
    [uninstall]=install
    [dc]=compose
    [up]=compose [down]=compose [restart]=compose [ps]=compose [logs]=compose [sh]=compose [build]=compose
    # dev / prod 只是「把 CX_MODE 設好再往下傳」的前綴動詞，實作同在 compose.sh。
    # test 不在這裡 —— 它有自己的檔，因為 cx test 同時是「test 模式的 compose」
    # 與「跑測試套件」兩件事（cx test up 與 cx test back）。
    [dev]=compose [prod]=compose
)

verb=${1:-tui}
[[ $# -gt 0 ]] && shift
# 指令檔需要知道自己是被哪個動詞叫進來的：CX_CMD_FILE_OF 讓多個動詞共用一個檔
# （up/down/ps/... 全都落在 compose.sh），沒有這個變數就分不出來。
export CX_VERB=$verb

case $verb in
    help|-h|--help) verb=help ;;
esac

file="$CX_ROOT/bin/cmd/${CX_CMD_FILE_OF[$verb]:-$verb}.sh"
[[ -f $file ]] || cx_die "$EX_USAGE" "未知的指令：'$verb'（試試 cx help）"

# shellcheck source=/dev/null
. "$file"

fn="cmd_${verb}_main"
declare -F "$fn" >/dev/null || fn="cmd_${CX_CMD_FILE_OF[$verb]:-$verb}_main"
declare -F "$fn" >/dev/null || cx_die "$EX_FAIL" "$file 未定義 $fn"

# 必須「測試」回傳值再 exit。
# 若寫成裸的 `"$fn" "$@"`，指令函式刻意回傳非零（例如 cx scan 找到 finding，
# 回傳 EX_SCAN_*）時會觸發 ERR trap，把正常結果印成 stack dump，
# CI 就分不出「掃描器有意見」與「掃描器當掉」。
_rc=0
"$fn" "$@" || _rc=$?
exit "$_rc"
